# PROJECT: NEON DRIVE — local vertical-slice runtime
# Copy to .env for Docker Compose local development.
# Do not use these example credentials in shared or production environments.

POSTGRES_DB=zneondrive
POSTGRES_USER=zneondrive
POSTGRES_PASSWORD=zneondrive-local
POSTGRES_PORT=55432

REDIS_PORT=56379
GAME_API_PORT=18080

# Local-only shared secret used by dedicated gameplay servers to redeem
# one-time gameplay tickets. Replace it outside local development.
GAME_SERVER_SHARED_KEY=zneondrive-local-server-key-change-me-0001
