# PROJECT: NEON DRIVE — local development environment
# Copy this file to .env and change local secrets before starting the stack.
# Never commit a populated .env file or reuse these example credentials in shared,
# staging, or production environments.

# -----------------------------------------------------------------------------
# PostgreSQL 17 — durable authoritative state
# -----------------------------------------------------------------------------
POSTGRES_DB=zneondrive
POSTGRES_USER=zneondrive
POSTGRES_PASSWORD=zneondrive-local
POSTGRES_PORT=55432

# Direct host URL for local tools/tests. Docker Compose builds its own DATABASE_URL
# using the POSTGRES_* variables above and the internal `postgres:5432` hostname.
DATABASE_URL=postgres://zneondrive:zneondrive-local@127.0.0.1:55432/zneondrive?sslmode=disable

# Integration-test database URL. Use only against a disposable test database.
TEST_DATABASE_URL=postgres://zneondrive:zneondrive-local@127.0.0.1:55432/zneondrive?sslmode=disable

# -----------------------------------------------------------------------------
# Redis 8 — ephemeral coordination / distributed rate limiting
# -----------------------------------------------------------------------------
REDIS_PORT=56379
REDIS_ADDR=127.0.0.1:56379
TEST_REDIS_ADDR=127.0.0.1:56379

# -----------------------------------------------------------------------------
# Go game API / observability
# -----------------------------------------------------------------------------
GAME_API_PORT=18080
GAME_API_METRICS_PORT=19090
LISTEN_ADDR=:8080
METRICS_LISTEN_ADDR=:9090

# Public/client-facing API endpoint used by local launcher/runtime tooling.
ZNEON_GAME_API_URL=http://127.0.0.1:18080

# Dedicated-server internal API endpoint. Keep this on a trusted/private path.
ZNEON_GAME_API_INTERNAL_URL=http://127.0.0.1:18080

# Leave empty for direct/local access so forwarded headers are ignored.
# In a proxied deployment set ONLY controlled ingress/proxy networks, for example:
# TRUSTED_PROXY_CIDRS=10.42.0.0/16,192.0.2.44
# Never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=

# -----------------------------------------------------------------------------
# Dedicated gameplay-server authentication
# -----------------------------------------------------------------------------
# Local-only placeholder. `make env-init` replaces this known placeholder with a
# random local secret. Never put a real production secret in .env.example.
GAME_SERVER_SHARED_KEY=zneondrive-local-server-key-change-me-0001

# Runtime environment consumed by the Unreal dedicated server only.
# It must match GAME_SERVER_SHARED_KEY at runtime, but must never be packaged into
# a player/client build. Prefer injecting this from the server environment/secret
# manager rather than writing it into a distributed artifact.
ZNEON_GAME_SERVER_KEY=zneondrive-local-server-key-change-me-0001

# -----------------------------------------------------------------------------
# Unreal Engine 5.8 Linux build/package tooling (optional for service-plane work)
# -----------------------------------------------------------------------------
# Example installed/source engine root. Override for your machine.
UE_ROOT=/opt/UnrealEngine-5.8

# Optional explicit dotnet executable for installed UE builds. Leave empty to let
# tools/ue-linux.sh discover the engine-bundled Linux dotnet, then system dotnet.
UE_DOTNET=

# Optional project override. Leave empty to use game/NeonDrive.uproject.
ZNEON_UE_PROJECT=

# Optional distribution root. Leave empty to use ./dist.
DIST_DIR=

# Optional packaged runtime locations used by control tooling.
CLIENT_INSTALL_DIR=
SERVER_INSTALL_DIR=
CLIENT_PACKAGE=
SERVER_PACKAGE=

# Extra command-line arguments for local Unreal client/server launchers.
CLIENT_ARGS=
GAME_SERVER_ARGS=

# -----------------------------------------------------------------------------
# Operator / control-surface options
# -----------------------------------------------------------------------------
LOG_TAIL=200

# Destructive local reset guard. Keep empty by default. Set only for one command:
# CONFIRM_RESET=YES make server-reset
CONFIRM_RESET=
