# PROJECT: NEON DRIVE — local development environment
# Copy this file to .env and change local secrets before starting the stack.
# Never commit a populated .env file or reuse these example credentials in shared,
# staging, or production environments.

# -----------------------------------------------------------------------------
# PostgreSQL 17 — durable authoritative state
# -----------------------------------------------------------------------------
POSTGRES_DB=zneondrive
POSTGRES_USER=zneondrive
POSTGRES_PASSWORD=zneondrive-local
POSTGRES_PORT=55432
POSTGRES_EXPORTER_PORT=19187
DATABASE_URL=postgres://zneondrive:zneondrive-local@127.0.0.1:55432/zneondrive?sslmode=disable
TEST_DATABASE_URL=postgres://zneondrive:zneondrive-local@127.0.0.1:55432/zneondrive?sslmode=disable

# -----------------------------------------------------------------------------
# Redis 8 — ephemeral coordination / distributed rate limiting
# -----------------------------------------------------------------------------
REDIS_PORT=56379
REDIS_ADDR=127.0.0.1:56379
TEST_REDIS_ADDR=127.0.0.1:56379

# -----------------------------------------------------------------------------
# Go game API / observability / public web
# -----------------------------------------------------------------------------
GAME_API_PORT=18080
GAME_API_METRICS_PORT=19090
WEB_PORT=18085
LISTEN_ADDR=:8080
METRICS_LISTEN_ADDR=:9090
ZNEON_GAME_API_URL=http://127.0.0.1:18080
ZNEON_GAME_API_INTERNAL_URL=http://127.0.0.1:18080
TRUSTED_PROXY_CIDRS=

# -----------------------------------------------------------------------------
# Dedicated gameplay-server authentication
# -----------------------------------------------------------------------------
GAME_SERVER_SHARED_KEY=zneondrive-local-server-key-change-me-0001
ZNEON_GAME_SERVER_KEY=zneondrive-local-server-key-change-me-0001

# -----------------------------------------------------------------------------
# Unreal Engine 5.8 Linux build/package tooling
# -----------------------------------------------------------------------------
UE_ROOT=/opt/UnrealEngine-5.8
UE_DOTNET=
ZNEON_UE_PROJECT=
DIST_DIR=
CLIENT_INSTALL_DIR=
SERVER_INSTALL_DIR=
CLIENT_PACKAGE=
SERVER_PACKAGE=
CLIENT_ARGS=
GAME_SERVER_ARGS=

# -----------------------------------------------------------------------------
# Operator / control-surface options
# -----------------------------------------------------------------------------
LOG_TAIL=200
CONFIRM_RESET=